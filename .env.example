# Local-only credentials. Every port is bound to 127.0.0.1.
# `make env` (or `make up`) copies this to .env if .env doesn't exist yet.
# Keep values URL-safe (no @ : / # %): the Postgres credentials are embedded in Prefect's DB URL.
POSTGRES_USER=fleetlake
POSTGRES_PASSWORD=fleetlake-local
S3_ACCESS_KEY=fleetlake
S3_SECRET_KEY=fleetlake-local
WAREHOUSE_BUCKET=warehouse

# Shared Iceberg JDBC catalog contract. Rows in iceberg_tables are keyed by catalog name,
# so every engine (Trino here, PyIceberg's SqlCatalog in the ingest code) must use this
# same name, or it won't see the other engine's tables.
ICEBERG_CATALOG_NAME=fleetlake
